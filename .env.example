# Copy this file to .env and supply values for the services you use.
# Never commit your populated .env file.

NODE_ENV=development
PORT=3001
SESSION_SECRET=

# PostgreSQL enables durable users, profiles, preferences, projects, files,
# submissions, practice catalog and PostgreSQL-backed sessions.
DATABASE_URL=

# Self-hosted Piston API. The backend accepts only local loopback services.
PISTON_API_URL=http://localhost:2000/api/v2

# Local Ollama endpoint and model; neither requires a paid API key.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Optional persistent volume directory for profile photos.
UPLOAD_DIR=uploads
